# Supabase project connection (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role key — server-only, NEVER exposed to the browser, NEVER prefixed
# with NEXT_PUBLIC_. Used only in trusted server contexts (e.g. an admin
# import route) that must bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the FastAPI ML microservice (ml-service/), used by the report
# submission Server Action to trigger scoring/retraining. See
# src/actions/submit-report.ts for how this is used.
FASTAPI_ML_SERVICE_URL=http://localhost:8000

# Shared secret the FastAPI service checks on incoming webhook calls from
# this frontend, so the ML service can reject requests that didn't
# originate from the app. Generate a long random value for production.
ML_SERVICE_WEBHOOK_SECRET=change-me-to-a-long-random-value
