# =====================================================================
# MAAGAP Monorepo .gitignore
# Next.js (App Router) frontend + Python/FastAPI ML microservice
# =====================================================================

# ---------------------------------------------------------------------
# Secrets & environment variables (NEVER commit these)
# ---------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
credentials.json
service-account*.json

# Supabase local config / keys
.supabase/
supabase/.temp/

# ---------------------------------------------------------------------
# Node.js / Next.js (frontend)
# ---------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Testing / coverage
coverage/
.nyc_output/

# ---------------------------------------------------------------------
# Python / FastAPI / ML pipeline (backend)
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# Packaging
*.egg-info/
dist/
build/
*.egg

# Testing / linting / type-checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------
# ML artifacts & data (large/binary — do not commit to Git history)
# ---------------------------------------------------------------------
# Raw PPDO source workbooks and any exports are kept local / in a data
# store (or Git LFS) rather than committed directly — they are large,
# frequently regenerated, and may contain sensitive project/contractor
# information not intended for a public repository.
/data/raw/
/data/processed/
/data/synthetic/
/data/ready/
/ml-service/artifacts/
*.npy
*.parquet
*.pkl
*.joblib
*.keras
*.h5
*.ckpt
model_artifacts/
mlruns/

# Uncomment if the raw workbook must stay out of every commit:
# *.xlsx
# *.xls

# Logs generated by the preprocessing pipeline
*.log
logs/

# ---------------------------------------------------------------------
# Docker / Dokploy
# ---------------------------------------------------------------------
*.env.docker

# ---------------------------------------------------------------------
# Local sandbox artifacts (harmless leftovers from initial repo setup —
# safe to delete manually from Windows Explorer)
# ---------------------------------------------------------------------
.git-broken/
.git-old-*/
**/.git-scaffold-nested-DELETE-ME/
**/.live_scores-test-artifact-DELETE-ME.json

# ---------------------------------------------------------------------
# ml-service/main.py's live re-scoring output — runtime state, not a
# committed artifact (regenerated per-project as inspector reports come
# in; see ml-service/inference/live_scoring.py's _persist_live_score).
# ---------------------------------------------------------------------
ml-service/artifacts/live_scores.json

# ---------------------------------------------------------------------
# Office lock/temp files (Word/Excel/LibreOffice)
# ---------------------------------------------------------------------
~$*.docx
~$*.xlsx
~$*.doc
~$*.xls
*.tmp

# ---------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
